package require tcltest
namespace import ::tcltest::*

::tcltest::loadTestedCommands
namespace import ::parsetcl::*

test parsetree-1.1 {Get parsetree from intrep} -body { #<<<
	set script	{
		# This is the first comment

		# this is another
		puts "hello, [try world; bar {*}{first second}] [concat {*}"$scalarvar more string contents"] $array(foo) $array(x$indexvar)"
		# Third comment
		foo {
			select
				*
			from
				things
			where
				interest > .5
		}

		puts {foo\u306f}
		puts "bar\u306f"  ;
		if {6 * 7 < 42} {error "math is broken"}

		switch -exact -- $foo {
			a {puts "foo is a"}
			b "puts \"foo is b\""
			c\u306fe {puts "foo is c"}
			"d\u306fe" {puts "foo is d"}
			{e\u306fe} {puts "foo is e"}
			default {puts "foo is unanticipated"}
		}
		#switch -exact -- $foo [list \
		#	a {puts "foo is a"} \
		#	b {puts "foo is b"} \
		#	c {puts "foo is c"} \
		#	default {puts "foo is unanticipated"} \
		#]
		#switch -exact -- $foo \
		#	a {puts "foo is a"} \
		#	b {puts "foo is b"} \
		#	c {puts "foo is c"} \
		#	default {puts "foo is unanticipated"}

		set sres	[subst {
			This is a var: $foo
			This is an array: $bar(baz,[cmdx; set x [cmdy asdf]])
			This is a command: [sfoo; sbar]
			These are escapes:
				\\u: ->\u306f<- (should be は)
				\\n: ->\n<- (should be a newline)
				\\x: ->\x6565<- (should be e65)
				\\o: ->\101<- (should be A)
				line continuation: foo->\
					<-bar
				literal: ->\"<- (should be ")
				lit u:	->\uXXX<- (should be uXXX)
				literal: ->\[<- (should be open bracket)
		}]
	}
	set pt	[parsetree $script]
	#set at	[ast $script]
	#puts stderr "reconstituted: ([domNode [node $pt] asText])"
	#puts stderr "parsetree: [domNode [node $at] asXML]"
	#puts stderr "ast: [domNode [node $at] asXML]"
	#puts stderr "subst value: [xpath [node $at] {string(//as/subst/@value)}]"
	#puts stderr "reconstitution time: [timerate {domNode [node $pt] asText}]"
	#puts stderr "parse time: [timerate {parsetree [string trim " $script"]}]"
	#puts stderr "ast time: [timerate {ast [string trim " $script"]}]"
	domNode [node $pt] asXML
} -cleanup {
	unset -nocomplain script pt at
} -result {<tcl>
