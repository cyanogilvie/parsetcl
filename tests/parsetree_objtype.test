                                                            <word idx="944" len="4" value="asdf">
                                                                <text idx="944" len="4">asdf</text>
                                                            </word>
                                                        </command>
                                                        <end idx="948" len="1">]</end>
                                                    </script>
                                                </word>
                                            </command>
                                            <end idx="949" len="1">]</end>
                                        </script>
                                    </var>
                                    <text idx="951" len="23">
			This is a command: </text>
                                    <syntax idx="974" len="1">[</syntax>
                                    <script idx="975" len="330" lineofs="0" linestarts="">
                                        <command idx="975" len="5" name="sfoo">
                                            <word idx="975" len="4" value="sfoo">
                                                <text idx="975" len="4">sfoo</text>
                                            </word>
                                        </command>
                                        <end idx="979" len="1">;</end>
                                        <space idx="980" len="1"> </space>
                                        <command idx="981" len="5" name="sbar">
                                            <word idx="981" len="4" value="sbar">
                                                <text idx="981" len="4">sbar</text>
                                            </word>
                                        </command>
                                        <end idx="985" len="1">]</end>
                                    </script>
                                    <text idx="986" len="27">
			These are escapes:
				</text>
                                    <escape idx="1013" len="2">\\</escape>
                                    <text idx="1015" len="5">u: -&gt;</text>
                                    <escape idx="1020" len="6">\u306f</escape>
                                    <text idx="1026" len="23">&lt;- (should be は)
				</text>
                                    <escape idx="1049" len="2">\\</escape>
                                    <text idx="1051" len="5">n: -&gt;</text>
                                    <escape idx="1056" len="2">\n</escape>
                                    <text idx="1058" len="29">&lt;- (should be a newline)
				</text>
                                    <escape idx="1087" len="2">\\</escape>
                                    <text idx="1089" len="5">x: -&gt;</text>
                                    <escape idx="1094" len="4">\x65</escape>
                                    <text idx="1098" len="25">65&lt;- (should be e65)
				</text>
                                    <escape idx="1123" len="2">\\</escape>
                                    <text idx="1125" len="5">o: -&gt;</text>
                                    <escape idx="1130" len="4">\101</escape>
                                    <text idx="1134" len="67">&lt;- (should be A)
				line continuation: foo-&gt; &lt;-bar
				literal: -&gt;</text>
                                    <escape idx="1201" len="2">\"</escape>
                                    <text idx="1203" len="30">&lt;- (should be ")
				lit u:	-&gt;</text>
                                    <escape idx="1233" len="2">\u</escape>
                                    <text idx="1235" len="38">XXX&lt;- (should be uXXX)
				literal: -&gt;</text>
                                    <escape idx="1273" len="2">\[</escape>
                                    <text idx="1275" len="30">&lt;- (should be open bracket)
		</text>
                                </subst>
                            </as>
                        </word>
                    </command>
                    <end idx="1306" len="1">]</end>
                </script>
            </word>
        </command>
        <end idx="1307" len="1">
</end>
        <space idx="1308" len="1">	</space>
    </script>
</tcl>
}
#>>>
test parsetree-2.1 {Script node character position} -body { #<<<
	set script	{
		puts "hello, ([world])"
		list a b
	}
	set pt	[parsetree $script]
	domNode [node $pt] asXML
} -cleanup {
	unset -nocomplain script pt
} -result {<tcl>
    <script idx="0" len="39" lineofs="0" linestarts="0">
        <space idx="0" len="3">
		</space>
        <command idx="3" len="24" name="puts">
            <word idx="3" len="4" value="puts">
                <text idx="3" len="4">puts</text>
            </word>
            <space idx="7" len="1"> </space>
            <word idx="8" len="18" quoted="quote">
                <text idx="9" len="8">hello, (</text>
                <syntax idx="17" len="1">[</syntax>
                <script idx="18" len="6" lineofs="17" linestarts="">
                    <command idx="18" len="6" name="world">
                        <word idx="18" len="5" value="world">
                            <text idx="18" len="5">world</text>
                        </word>
                    </command>
                    <end idx="23" len="1">]</end>
                </script>
                <text idx="24" len="1">)</text>
            </word>
        </command>
        <end idx="26" len="1">
</end>
        <space idx="27" len="2">		</space>
        <command idx="29" len="9" name="list">
            <word idx="29" len="4" value="list">
                <text idx="29" len="4">list</text>
            </word>
            <space idx="33" len="1"> </space>
            <word idx="34" len="1" value="a">
                <text idx="34" len="1">a</text>
            </word>
            <space idx="35" len="1"> </space>
            <word idx="36" len="1" value="b">
                <text idx="36" len="1">b</text>
            </word>
        </command>
        <end idx="37" len="1">
</end>
        <space idx="38" len="1">	</space>
    </script>
</tcl>
}
#>>>
test parsetree-3.1 {Shimmer to string while orphaned refs remain bug} -body { #<<<
	set script	{puts "hello, world"}
	set pt	[parsetree $script]
	list [string range $script 0 3] [xpath [node $pt] {string(//command[@name="puts"][1]/word[2])}]
} -cleanup {
	unset -nocomplain script pt
} -result {puts {hello, world}}
#>>>
test parsetree-3.2 {Noderef string form does not leak heap pointers} -body { #<<<
	set pt [parsetree {puts hi}]
	# Force serialization
	set s [string range $pt 0 end]
	# Expect three list elements: tag, tdom command name, integer cookie
	lassign $s tag cmd cookie
	list \
		$tag \
		[regexp {^domNode[0-9a-fx]+$} $cmd] \
		[string is integer -strict $cookie] \
		[expr {$cookie > 0}]
} -cleanup {
	unset -nocomplain pt s tag cmd cookie
} -result {parsetcl_noderef 1 1 1}
#>>>
test parsetree-3.3 {Forged noderef with unknown cookie is rejected} -body { #<<<
	parsetcl::node {parsetcl_noderef domNode0xdeadbeef 999999999}
} -returnCodes error -result {The script dom the node refers to does not exist in this thread}
#>>>
test parsetree-3.4 {Forged noderef with reserved cookie 0 is rejected} -body { #<<<
	parsetcl::node {parsetcl_noderef domNode0xdeadbeef 0}
} -returnCodes error -result {The script dom the node refers to does not exist in this thread}
#>>>
test parsetree-3.5 {Noderef revived while pt still exists works} -body { #<<<
	set pt [parsetree {set x 1}]
	set s  [string range " $pt" 1 end]
	xpath [parsetcl::node $s] {string(//command[@name="set"]/word[2])}
} -cleanup {
	unset -nocomplain pt s
} -result x
#>>>
test parsetree-3.6 {Noderef revived after pt dropped fails cleanly} -body { #<<<
	set pt [parsetree {set x 1}]
	set s  [string range " $pt" 1 end]
	unset pt
	xpath [parsetcl::node $s] {string(//command[@name="set"]/word[2])}
} -cleanup {
	unset -nocomplain pt s
} -returnCodes error -result {The script dom the node refers to does not exist in this thread}
#>>>

::tcltest::cleanupTests

